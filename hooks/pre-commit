#!/usr/bin/env bash
#
# little-sister pre-commit hook: run lint and tests before a commit is allowed.
#
# This hook is version-controlled in hooks/ rather than .git/hooks/ so it can
# be shared. Enable it once per clone with:
#
#     git config core.hooksPath hooks
#
# It mirrors the quality gate documented in AGENTS.md.

set -euo pipefail

echo "pre-commit: ruff check"
uv run ruff check

echo "pre-commit: mypy"
uv run mypy

# Against the floor `requires-python` promises, not against the interpreter this is
# developed on (ADR-0054). Static and about a second, so it belongs on every commit;
# the floor *test* run is heavier and rides the release gate instead.
echo "pre-commit: mypy (floor 3.11)"
uv run mypy --python-version 3.11

echo "pre-commit: pytest"
uv run pytest -q

echo "pre-commit: all checks passed"
